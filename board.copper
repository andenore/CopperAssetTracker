// Full-vertical acceptance design: source language -> electrical IR/ERC ->
// physical IR -> KiCad PCB -> manufacturing outputs. Values and RF networks
// remain subject to schematic/layout review before fabrication.
board CopperAssetTracker {
    use library "tiny";
    import gct_usb "github.com/andenore/CopperLib/packages/parts/gct/usb4135";
    import tusb "github.com/andenore/CopperLib/packages/parts/ti/tusb320lai";
    import st_mcu "github.com/andenore/CopperLib/packages/parts/st/stm32g0c1";
    import nordic "github.com/andenore/CopperLib/packages/parts/nordic/nrf52832";
    import st_accel "github.com/andenore/CopperLib/packages/parts/st/lis2dw12";
    import ublox "github.com/andenore/CopperLib/packages/parts/u-blox/max-m10s";
    import coilcraft "github.com/andenore/CopperLib/packages/parts/coilcraft/0603usb";
    import gct_sim "github.com/andenore/CopperLib/packages/parts/gct/sim8060";
    import swd "github.com/andenore/CopperLib/packages/interfaces/arm/swd-10pin";
    import tracker "./src/tracker";
    import simcom "github.com/andenore/CopperLib/packages/parts/simcom/sim7670g-lngv";
    import translator "github.com/andenore/CopperLib/packages/parts/ti/sn74axc2t245";
    import onsemi "github.com/andenore/CopperLib/packages/parts/onsemi/bss138";
    import uart_header "github.com/andenore/CopperLib/packages/interfaces/uart/jst-xh4";
    import eswitch "github.com/andenore/CopperLib/packages/parts/e-switch/tl3342";
    import yxc "github.com/andenore/CopperLib/packages/parts/yxc/ysx321sl";
    import kento "github.com/andenore/CopperLib/packages/parts/kento/kt0603r";
    import rf "./src/rf";

    import logic_layout "github.com/andenore/CopperLib/packages/circuits/ti/tps63020-buck-boost";
    import modem_layout "github.com/andenore/CopperLib/packages/circuits/ti/tps63020-buck-boost";

    component J_POWER: gct_usb.GCT_USB4135_GF_A;
    component U_CC: tusb.TUSB320LAI;
    module PWR: tracker.AssetTrackerPowerTree;

    component U_MCU: st_mcu.STM32G0C1RET6;
    component U_MODEM: simcom.SIM7670G_LNGV;
    component U_MODEM_LEVEL: translator.MODEM_UART_TRANSLATOR;
    component U_MODEM_KEY: onsemi.BSS138;
    component U_NRF: nordic.NRF52832_QFAA;
    component U_ACCEL: st_accel.LIS2DW12;
    component U_GNSS: ublox.MAX_M10S_00B;
    component FL_USB: coilcraft.COILCRAFT_0603USB_601MLC;

    // Synthesized printed antennas (constraint antenna below): each feed is a
    // bare one-land pad where the generated radiator starts.
    component ANT_CELL: rf.AntennaFeed;
    component ANT_GNSS: rf.AntennaFeed;
    component ANT_BT: rf.AntennaFeed;
    component J_SIM: gct_sim.SIM8060_6_0_14_00_A;
    component J_DEBUG: uart_header.DEBUG_HEADER;
    component J_SWD_MCU: swd.SWD_HEADER;
    component J_SWD_NRF: swd.SWD_HEADER;
    component SW_USER: eswitch.TL3342F160QG;
    component LED_1: kento.KENTO_KT0603R;
    component LED_2: kento.KENTO_KT0603R;

    component R_I2C_SDA: RESISTOR { value = 4.7kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_I2C_SCL: RESISTOR { value = 4.7kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_CC_VBUS: RESISTOR { value = 300kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_CC_VBUS2: RESISTOR { value = 300kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_CC_VBUS3: RESISTOR { value = 300kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_CC_OUT1: RESISTOR { value = 10kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_CC_OUT2: RESISTOR { value = 10kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_LED_1: RESISTOR { value = 1kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_LED_2: RESISTOR { value = 1kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_RESET_MCU: RESISTOR { value = 10kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_RESET_NRF: RESISTOR { value = 10kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component L_BT_MATCH: INDUCTOR { value = 3.9nH; footprint = "Inductor_SMD:L_0402_1005Metric"; }
    component C_BT_MATCH: CAPACITOR { value = 0.8pF; footprint = "Capacitor_SMD:C_0402_1005Metric"; }
    // BLE trace-antenna L-section after Nordic's C3/L1, radio side first:
    // shunt 4.3 nH, series 2.0 pF. The ble synthesis report's ideal values are
    // 4.39 nH / 2.03 pF; these E-series values keep -18.7 dB worst in band on
    // its simulated impedance. Simulation only: retune on the bench.
    component L_BT_SHUNT: INDUCTOR { value = 4.3nH; footprint = "Inductor_SMD:L_0402_1005Metric"; }
    component C_BT_SERIES: CAPACITOR { value = 2pF; footprint = "Capacitor_SMD:C_0402_1005Metric"; }
    // MAX-M10S RF_IN is matched and DC-blocked inside the module; this
    // L-section matches the printed GNSS antenna, radio side first: series
    // 3.9 pF, shunt 1.2 pF. The gnss synthesis report's ideal values are
    // 4.04 pF / 1.18 pF; these E-series values keep -13.0 dB worst in band on
    // its simulated impedance. Simulation only: retune on the bench.
    component C_GNSS_SERIES: CAPACITOR { value = 3.9pF; footprint = "Capacitor_SMD:C_0402_1005Metric"; }
    component C_GNSS_SHUNT: CAPACITOR { value = 1.2pF; footprint = "Capacitor_SMD:C_0402_1005Metric"; }
    component C_MCU: CAPACITOR { value = 100nF; footprint = "Capacitor_SMD:C_0402_1005Metric"; role = decoupling; decouples = "U_MCU.VDD"; }
    component C_CC: CAPACITOR { value = 1uF; footprint = "Capacitor_SMD:C_0603_1608Metric"; role = decoupling; decouples = "U_CC.VDD"; }
    component C_NRF: CAPACITOR { value = 4.7uF; footprint = "Capacitor_SMD:C_0603_1608Metric"; role = decoupling; decouples = "U_NRF.VDD_1"; }
    component C_ACCEL: CAPACITOR { value = 100nF; footprint = "Capacitor_SMD:C_0402_1005Metric"; role = decoupling; decouples = "U_ACCEL.VDD"; }
    component C_GNSS: CAPACITOR { value = 1uF; footprint = "Capacitor_SMD:C_0603_1608Metric"; role = decoupling; decouples = "U_GNSS.VCC"; }
    component R_KEY_PD: RESISTOR { value = 100kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component C_LEVEL_A: CAPACITOR { value = 100nF; footprint = "Capacitor_SMD:C_0402_1005Metric"; role = decoupling; decouples = "U_MODEM_LEVEL.VCCA"; }
    component C_LEVEL_B: CAPACITOR { value = 100nF; footprint = "Capacitor_SMD:C_0402_1005Metric"; role = decoupling; decouples = "U_MODEM_LEVEL.VCCB"; }
    // SIM7672X Hardware Design V1.01 Figure 30 / p59 antenna matching network,
    // module side first: shunt C1, series R1, shunt C2, series R2 (100 pF DC
    // block). Fitted as a pi match for the printed LTE antenna: 9.1 pF shunt,
    // 1.5 nH series, 2.7 nH shunt. The lte synthesis report's two-element
    // L-section reached only -5.3 dB over B20; this pi, searched on the
    // report's fine-mesh feed impedance with the DC block and assumed part Q
    // (revisions/pcb-antennas-v1/lte_pi_match.py), gives -8.0 dB worst in
    // band and -6.1 dB at tolerance corners. Simulation only: retune on the
    // bench.
    component C_CELL_SHUNT1: CAPACITOR { value = 9.1pF; footprint = "Capacitor_SMD:C_0402_1005Metric"; }
    component L_CELL_SERIES: INDUCTOR { value = 1.5nH; footprint = "Inductor_SMD:L_0402_1005Metric"; }
    component L_CELL_SHUNT: INDUCTOR { value = 2.7nH; footprint = "Inductor_SMD:L_0402_1005Metric"; }
    component C_CELL_SERIES: CAPACITOR { value = 100pF; footprint = "Capacitor_SMD:C_0402_1005Metric"; }
    component C_MODEM_BULK: CAPACITOR { value = 100uF; footprint = "Capacitor_SMD:C_1210_3225Metric"; }
    component U_MODEM_STATUS: translator.MODEM_STATUS_TRANSLATOR;
    component C_STATUS_A: CAPACITOR { value = 100nF; footprint = "Capacitor_SMD:C_0402_1005Metric"; role = decoupling; decouples = "U_MODEM_STATUS.VCCA"; }
    component C_STATUS_B: CAPACITOR { value = 100nF; footprint = "Capacitor_SMD:C_0402_1005Metric"; role = decoupling; decouples = "U_MODEM_STATUS.VCCB"; }
    // Nordic LDO reference support; firmware must leave DC/DC disabled.
    component C_DEC1: CAPACITOR { value = 100nF; footprint = "Capacitor_SMD:C_0402_1005Metric"; role = decoupling; decouples = "U_NRF.DEC1"; }
    component C_DEC3: CAPACITOR { value = 100pF; footprint = "Capacitor_SMD:C_0402_1005Metric"; role = decoupling; decouples = "U_NRF.DEC3"; }
    component C_DEC4: CAPACITOR { value = 1uF; footprint = "Capacitor_SMD:C_0603_1608Metric"; role = decoupling; decouples = "U_NRF.DEC4"; }
    component C_NRF_VDD2: CAPACITOR { value = 100nF; footprint = "Capacitor_SMD:C_0402_1005Metric"; role = decoupling; decouples = "U_NRF.VDD_2"; }
    component C_NRF_VDD3: CAPACITOR { value = 100nF; footprint = "Capacitor_SMD:C_0402_1005Metric"; role = decoupling; decouples = "U_NRF.VDD_3"; }
    component Y_NRF: yxc.YXC_X322532MOB4SI;
    // Starting load values for catalogued CL=12pF; measure/tune on the board.
    component C_XC1: CAPACITOR { value = 18pF; footprint = "Capacitor_SMD:C_0402_1005Metric"; }
    component C_XC2: CAPACITOR { value = 18pF; footprint = "Capacitor_SMD:C_0402_1005Metric"; }

    configure U_MCU.USART1 as MODEM_UART {
        TX = PB6;
        RX = PB7;
    }
    configure U_MCU.USART2 as GNSS_UART {
        TX = PA2;
        RX = PA3;
    }
    configure U_MCU.USART3 as NRF_UART {
        TX = PB8;
        RX = PB9;
    }
    configure U_MCU.USART6 as DEBUG_UART {
        TX = PA4;
        RX = PA5;
    }
    configure U_MCU.I2C2 as MOTION_I2C {
        SDA = PA6;
        SCL = PA7;
    }
    configure U_MCU.USB_FS as MODEM_USB {
        DP = PA12;
        DM = PA11;
    }
    configure U_NRF.UARTE0 as HOST_UART {
        TX = P0_06;
        RX = P0_08;
    }

    net V5 {
        J_POWER.VBUS_A;
        J_POWER.VBUS_B;
        PWR.VIN5;
        R_CC_VBUS.1;
    }
    net V3V3 {
        PWR.V3V3;
        U_MCU.VDD;
        U_MCU.VBAT;
        U_MCU.VREF_PLUS;
        U_CC.VDD;
        R_CC_OUT1.1;
        R_CC_OUT2.1;
        C_CC.1;
        U_MODEM_LEVEL.VCCA;
        U_MODEM_STATUS.VCCA;
        C_STATUS_A.1;
        C_NRF_VDD2.1;
        C_NRF_VDD3.1;
        C_LEVEL_A.1;
        U_MODEM_LEVEL.DIR1;
        U_NRF.VDD_1;
        U_NRF.VDD_2;
        U_NRF.VDD_3;
        U_ACCEL.VDD;
        U_ACCEL.VDD_IO;
        U_ACCEL.CS;
        U_GNSS.VCC;
        U_GNSS.V_IO;
        U_GNSS.V_BCKP;
        U_MODEM.GNSS_VBKP;
        J_DEBUG.VREF;
        J_SWD_MCU.VREF;
        J_SWD_NRF.VREF;
        R_I2C_SDA.1;
        R_I2C_SCL.1;
        R_RESET_MCU.1;
        R_RESET_NRF.1;
        C_MCU.1;
        C_NRF.1;
        C_ACCEL.1;
        C_GNSS.1;
    }
    net V3V8 {
        PWR.V3V8;
        // Battery-fed USB detection. SIM7672X V1.01 applicability assumed by user.
        // Requires >=3.6 V at pad 24 under burst load; qualification stays open.
        U_MODEM.USB_VBUS;
        U_MODEM.VBAT_1;
        U_MODEM.VBAT_2;
        U_MODEM.VBAT_3;
        C_MODEM_BULK.1;
    }
    net V1V8_MODEM {
        U_MODEM.VDD_EXT;
        U_MODEM_LEVEL.VCCB;
        U_MODEM_STATUS.VCCB;
        C_STATUS_B.1;
        U_MODEM.GNSS_VDD;
        C_LEVEL_B.1;
    }
    net GND {
        J_POWER.GND_A;
        J_POWER.GND_B;
        J_POWER.SHIELD;
        PWR.GND;
        U_CC.PORT;
        U_CC.GND;
        U_CC.EN_N;
        C_CC.2;
        U_MCU.VSS;
        U_MODEM.GND;
        U_MODEM.GND_17;
        U_MODEM.GND_18;
        U_MODEM.GND_29;
        U_MODEM.GND_39;
        U_MODEM.GND_45;
        U_MODEM.GND_46;
        U_MODEM.GND_54;
        U_MODEM.GND_58;
        U_MODEM.GND_59;
        U_MODEM.GND_61;
        U_MODEM.GND_62;
        U_MODEM.GND_63;
        U_MODEM.GND_64;
        U_MODEM.GND_65;
        U_MODEM.GND_69;
        U_MODEM.GND_70;
        U_MODEM.GND_71;
        U_MODEM.GND_72;
        U_MODEM.GND_73;
        U_MODEM.GND_74;
        U_MODEM.GND_75;
        U_MODEM.GND_76;
        U_MODEM.GND_77;
        U_MODEM.GND_78;
        U_MODEM.GND_79;
        U_MODEM.GND_80;
        U_MODEM.GND_81;
        U_MODEM.GND_82;
        U_MODEM.GND_83;
        U_MODEM.GND_84;
        U_MODEM.GND_85;
        U_MODEM.GND_86;
        U_MODEM.GND_87;
        U_MODEM.GND_88;
        U_MODEM.GND_89;
        U_MODEM.GND_91;
        U_MODEM.GND_92;
        U_MODEM.GND_94;
        U_MODEM_LEVEL.GND;
        U_MODEM_LEVEL.OE_N;
        U_MODEM_LEVEL.DIR2;
        U_MODEM_STATUS.GND;
        U_MODEM_STATUS.OE_N;
        U_MODEM_STATUS.DIR1;
        U_MODEM_STATUS.DIR2;
        U_MODEM_STATUS.B_UNUSED;
        C_STATUS_A.2;
        C_STATUS_B.2;
        C_DEC1.2;
        C_DEC3.2;
        C_DEC4.2;
        C_NRF_VDD2.2;
        C_NRF_VDD3.2;
        Y_NRF.GND_2;
        Y_NRF.GND_4;
        C_XC1.2;
        C_XC2.2;
        U_MODEM_KEY.GND;
        R_KEY_PD.2;
        C_LEVEL_A.2;
        C_LEVEL_B.2;
        U_NRF.VSS_1;
        U_NRF.VSS_2;
        U_NRF.VSS_EP;
        U_ACCEL.SDO_SA0;
        U_ACCEL.GND_1;
        U_ACCEL.RES;
        U_ACCEL.GND_2;
        U_GNSS.GND_1;
        U_GNSS.GND_2;
        U_GNSS.GND_3;
        C_CELL_SHUNT1.1;
        L_CELL_SHUNT.1;
        J_SIM.GND;
        J_SIM.SHIELD;
        J_DEBUG.GND;
        J_DEBUG.MP;
        J_SWD_MCU.GND;
        J_SWD_MCU.GND_5;
        J_SWD_MCU.GND_DETECT;
        J_SWD_NRF.GND;
        J_SWD_NRF.GND_5;
        J_SWD_NRF.GND_DETECT;
        SW_USER.B;
        LED_1.K;
        LED_2.K;
        C_BT_MATCH.1;
        L_BT_SHUNT.1;
        C_GNSS_SHUNT.1;
        C_MCU.2;
        C_NRF.2;
        C_ACCEL.2;
        C_GNSS.2;
        C_MODEM_BULK.2;
    }

    net MCU_MODEM_TX { U_MCU.PB6; U_MODEM_LEVEL.A_TX; }
    net MCU_MODEM_RX { U_MCU.PB7; U_MODEM_LEVEL.A_RX; }
    net MODEM_UART_RX { U_MODEM_LEVEL.B_RX; U_MODEM.MAIN_RXD; }
    net MODEM_UART_TX { U_MODEM_LEVEL.B_TX; U_MODEM.MAIN_TXD; }
    net MODEM_PWRKEY_CTL { U_MCU.PC0; U_MODEM_KEY.IN; R_KEY_PD.1; }
    net MODEM_PWRKEY { U_MODEM_KEY.OUT; U_MODEM.PWRKEY; }
    net MODEM_STATUS_1V8 { U_MODEM.STATUS; U_MODEM_STATUS.B_STATUS; }
    net MODEM_STATUS { U_MODEM_STATUS.A_STATUS; U_MCU.PC1; }
    net NRF_DEC1 { U_NRF.DEC1; C_DEC1.1; }
    net NRF_DEC3 { U_NRF.DEC3; C_DEC3.1; }
    net NRF_DEC4 { U_NRF.DEC4; C_DEC4.1; }
    net NRF_XC1 { U_NRF.XC1; Y_NRF.XTAL1; C_XC1.1; }
    net NRF_XC2 { U_NRF.XC2; Y_NRF.XTAL2; C_XC2.1; }
    // The modem takes the choke's IN ends and the MCU its OUT ends. Both chips'
    // USB pins face each other with DP on the same side, and this assignment
    // keeps that order through the choke; the reverse one forces DP/DM to cross.
    net USB_DP_MCU { U_MCU.PA12; FL_USB.DP_OUT; }
    net USB_DM_MCU { U_MCU.PA11; FL_USB.DM_OUT; }
    net USB_DP_MODEM { FL_USB.DP_IN; U_MODEM.USB_DP; }
    net USB_DM_MODEM { FL_USB.DM_IN; U_MODEM.USB_DM; }
    net CELL_RF { U_MODEM.ANT_MAIN; C_CELL_SHUNT1.2; L_CELL_SERIES.1; }
    net CELL_RF_MATCH { L_CELL_SERIES.2; L_CELL_SHUNT.2; C_CELL_SERIES.1; }
    net CELL_RF_ANT { C_CELL_SERIES.2; ANT_CELL.FEED; }
    net SIM_VCC { U_MODEM.USIM_VDD; J_SIM.VCC; }
    net SIM_RST { U_MODEM.USIM_RST; J_SIM.RST; }
    net SIM_CLK { U_MODEM.USIM_CLK; J_SIM.CLK; }
    net SIM_IO { U_MODEM.USIM_DATA; J_SIM.IO; }

    net MCU_NRF_TX { U_MCU.PB8; U_NRF.P0_08; }
    net MCU_NRF_RX { U_MCU.PB9; U_NRF.P0_06; }
    net NRF_RESET { U_NRF.P0_21_NRESET; J_SWD_NRF.RESET; R_RESET_NRF.2; }
    net NRF_SWDIO { U_NRF.SWDIO; J_SWD_NRF.SWDIO; }
    net NRF_SWDCLK { U_NRF.SWDCLK; J_SWD_NRF.SWDCLK; }
    // Nordic QFAA reference v1.1: C3 is shunt on the chip side of L1.
    // Follow vendor physical C3 numbering: upper pad 1 GND, lower pad 2 ANT.
    net NRF_RF_RAW { U_NRF.ANT; C_BT_MATCH.2; L_BT_MATCH.1; }
    net NRF_RF_ANT { L_BT_MATCH.2; L_BT_SHUNT.2; C_BT_SERIES.1; }
    net ANT_FEED { C_BT_SERIES.2; ANT_BT.FEED; }

    net GNSS_TX { U_GNSS.TXD; U_MCU.PA3; }
    net GNSS_RX { U_GNSS.RXD; U_MCU.PA2; }
    net GNSS_TIMEPULSE { U_GNSS.TIMEPULSE; U_MCU.PC3; }
    net GNSS_RF { U_GNSS.RF_IN; C_GNSS_SERIES.1; }
    net GNSS_RF_ANT { C_GNSS_SERIES.2; C_GNSS_SHUNT.2; ANT_GNSS.FEED; }

    net I2C_SDA { U_MCU.PA6; U_ACCEL.SDA; R_I2C_SDA.2; }
    net I2C_SCL { U_MCU.PA7; U_ACCEL.SCL; R_I2C_SCL.2; }
    net ACCEL_INT { U_ACCEL.INT1; U_MCU.PC2; }

    net USER_BUTTON { U_MCU.PC13; SW_USER.A; }
    net USER_LED_1 { U_MCU.PC6; R_LED_1.1; }
    net USER_LED_1_A { R_LED_1.2; LED_1.A; }
    net USER_LED_2 { U_MCU.PC7; R_LED_2.1; }
    net USER_LED_2_A { R_LED_2.2; LED_2.A; }

    net DEBUG_TX { U_MCU.PA4; J_DEBUG.TX; }
    net DEBUG_RX { U_MCU.PA5; J_DEBUG.RX; }
    net MCU_RESET { U_MCU.NRST; J_SWD_MCU.RESET; R_RESET_MCU.2; }
    net MCU_SWDIO { U_MCU.PA13; J_SWD_MCU.SWDIO; }
    net MCU_SWDCLK { U_MCU.PA14; J_SWD_MCU.SWDCLK; }

    net USB_C_CC1 { J_POWER.CC1; U_CC.CC1; }
    net USB_C_CC2 { J_POWER.CC2; U_CC.CC2; }
    net USB_C_VBUS_SERIES1 { R_CC_VBUS.2; R_CC_VBUS2.1; }
    net USB_C_VBUS_SERIES2 { R_CC_VBUS2.2; R_CC_VBUS3.1; }
    net USB_C_VBUS_DET { R_CC_VBUS3.2; U_CC.VBUS_DET; }
    net USB_C_CURRENT_1 { U_CC.OUT1; R_CC_OUT1.2; U_MCU.PC8; }
    net USB_C_CURRENT_2 { U_CC.OUT2; R_CC_OUT2.2; U_MCU.PC9; }
    net MODEM_EN { U_MCU.PC10; PWR.MODEM_EN; }

    supply V5 { voltage = 5V; external = true; }
    supply V3V3 { voltage = 3.3V; external = true; }
    supply V3V8 { voltage = 3.8V; external = true; }
    supply GND { voltage = 0V; external = true; }

    power_state NORMAL {
        V5 = on;
        V3V3 = on;
        V3V8 = on;
        GND = on;
    }
    power_state LOGIC_ONLY {
        V5 = on;
        V3V3 = on;
        V3V8 = off;
        GND = on;
    }
    power_state BATTERY_ONLY {
        V5 = off;
        V3V3 = on;
        V3V8 = on;
        GND = on;
    }

    interface MOTION_BUS: i2c {
        sda = I2C_SDA;
        scl = I2C_SCL;
        pullup = V3V3;
        bind U_MCU { sda = PA6; scl = PA7; }
        bind U_ACCEL { sda = SDA; scl = SCL; }
    }

    // Mechanical intent for the provisional 100 x 80 mm outline. Coordinates
    // are footprint origins, x right / y down; all fixed parts are on front.
    // Connector/antenna courtyards retain the planner's 2 mm edge clearance.
    // Single-sided assembly: no part may be placed on the back, including
    // decouplers the planner would otherwise flip under their pins.
    constraint keepout() {
        name = "single-sided-assembly";
        x = 0mm; y = 0mm; width = 100mm; height = 80mm;
        side = back;
    }
    // Bottom-left entry: USB-C opening faces the bottom edge.
    constraint fixed_placement(J_POWER) {
        x = 12mm; y = 74mm; rotation = 0; side = front;
    }
    // ANT_MAIN (pad 60) is on the west edge at this rotation: (10.1 mm, 24 mm).
    constraint fixed_placement(U_MODEM) {
        x = 22.1mm; y = 24mm; rotation = 90; side = front;
    }
    // The matching network runs south from the LTE antenna feed (ANT_CELL,
    // fixed by its antenna constraint) along x = 4.4 mm, then east to ANT_MAIN
    // at y = 24 mm, inside the SIM7672X V1.01 p60 maximum of 20 mm.
    // Series parts sit on the line; each shunt's RF pad is on the line with
    // its GND pad to the west. Antenna side first: R2, C2, R1, C1
    // (C_CELL_SERIES, L_CELL_SHUNT, L_CELL_SERIES, C_CELL_SHUNT1).
    constraint fixed_placement(C_CELL_SERIES) { x = 4.4mm; y = 18.9mm; rotation = 90; side = front; }
    constraint fixed_placement(L_CELL_SHUNT) { x = 3.92mm; y = 20.9mm; rotation = 0; side = front; }
    constraint fixed_placement(L_CELL_SERIES) { x = 4.4mm; y = 22.9mm; rotation = 90; side = front; }
    constraint fixed_placement(C_CELL_SHUNT1) { x = 3.92mm; y = 24.9mm; rotation = 0; side = front; }
    // SIM insertion faces left; contact lands face right, toward the modem.
    constraint fixed_placement(J_SIM) {
        x = 10mm; y = 51mm; rotation = 270; side = front;
    }
    // The nordic-rf macro places C3 and L1 with U_NRF; L1's output (86.1 mm,
    // 18.5 mm) runs to the BLE L-section on y = 16.7 mm, level with the BLE
    // antenna feed (92.66 mm, 16.7 mm). The shunt's GND pad faces south.
    constraint fixed_placement(U_NRF) {
        x = 80mm; y = 18mm; rotation = 0; side = front;
    }
    constraint fixed_placement(L_BT_SHUNT) { x = 88mm; y = 17.18mm; rotation = 90; side = front; }
    constraint fixed_placement(C_BT_SERIES) { x = 90mm; y = 16.7mm; rotation = 0; side = front; }
    // Rigid TPS63020 macros own both converters' support placement and copper.
    constraint fixed_placement(PWR/U_MODEM) {
        x = 54mm; y = 48mm; rotation = 0; side = front;
    }
    constraint fixed_placement(PWR/U_LOGIC) { x = 49mm; y = 63mm; rotation = 0; side = front; }
    constraint fixed_placement(PWR/J_BAT) {
        x = 70mm; y = 71mm; rotation = 0; side = front;
    }
    // Turned so RF_IN (84.25 mm, 50.3 mm) faces east, low enough that the
    // module's courtyard clears the charger's C_BAT and R_ISET. The feed runs
    // east, then north through the series part to the shunt node level with
    // the GNSS antenna feed (88.66 mm, 44.7 mm), which the shunt's RF pad
    // faces from 1.4 mm south; its GND pad points south.
    constraint fixed_placement(U_GNSS) {
        x = 79.5mm; y = 47mm; rotation = 270; side = front;
    }
    constraint fixed_placement(C_GNSS_SERIES) { x = 87mm; y = 48mm; rotation = 90; side = front; }
    constraint fixed_placement(C_GNSS_SHUNT) { x = 88.66mm; y = 46.6mm; rotation = 90; side = front; }

    constraint max_distance(C_MCU, U_MCU.VDD) { distance = 3mm; }
    // The MCU at the pose the planner settles on, with C_MCU turned beside
    // VDD/VSS (pins 8/9): its GND pad faces VSS, so V3V3 copper cannot box the
    // VSS land in away from the capacitor's ground.
    constraint fixed_placement(U_MCU) { x = 48.6mm; y = 21mm; rotation = 180; side = front; }
    constraint fixed_placement(C_MCU) { x = 56.3mm; y = 21mm; rotation = 90; side = front; }
    // Keep the USB choke in the short corridor between the modem's USB pads
    // and the MCU's PA11/PA12, turned so its IN ends face the modem (west).
    constraint max_distance(FL_USB.DP_OUT, U_MCU.PA12) { distance = 5mm; }
    constraint max_distance(FL_USB.DP_IN, U_MODEM.USB_DP) { distance = 5mm; }
    constraint allowed_orientations(FL_USB) { values = "90"; }
    // Centre the choke on y = 22.5 mm, the midpoint of PA11/PA12 (22.25/22.75)
    // and of the modem's USB_DM/USB_DP pads (22.0/23.0); the planner's free
    // pose (y = 23.225) left a 0.725 mm jog the pair lattice cannot take
    // straight, so the pairs looped around the choke.
    constraint fixed_placement(FL_USB) { x = 39mm; y = 22.5mm; rotation = 90; side = front; }
    // Leave the MCU room to move while keeping its USB pins in the upper lane.
    constraint placement_region(U_MCU) {
        name = "mcu-usb-lane"; x = 38mm; y = 14mm; width = 20mm; height = 20mm;
    }
    constraint max_distance(C_CC, U_CC.VDD) { distance = 3mm; }
    constraint max_distance(C_NRF, U_NRF.VDD_1) { distance = 3mm; }
    constraint max_distance(C_NRF_VDD2, U_NRF.VDD_2) { distance = 3mm; }
    constraint max_distance(C_NRF_VDD3, U_NRF.VDD_3) { distance = 3mm; }
    constraint max_distance(C_DEC1, U_NRF.DEC1) { distance = 3mm; }
    // Exact locked courtyards require about 1.85 mm pad-to-pad here; the
    // routing rule still bounds the actual F.Cu connection to 2 mm / no vias.
    constraint max_distance(C_DEC3.1, U_NRF.DEC3) { distance = 2mm; }
    constraint max_distance(C_DEC4, U_NRF.DEC4) { distance = 3mm; }
    // Authored layout limits implementing Nordic's short HFXO routing intent;
    // these are not universal vendor maximums or oscillator qualification.
    constraint max_distance(Y_NRF, U_NRF.XC1) { distance = 5mm; }
    constraint max_distance(C_XC1, Y_NRF.XTAL1) { distance = 2mm; }
    constraint max_distance(C_XC2, Y_NRF.XTAL2) { distance = 2mm; }
    constraint fixed_placement(C_DEC1) { x = 75.4mm; y = 15.8mm; rotation = 90; side = front; }
    // Horizontal DEC3 puts its ground land away from the HFXO exit corridor.
    constraint fixed_placement(C_DEC3) { x = 85.03mm; y = 16.13mm; rotation = 0; side = front; }
    constraint fixed_placement(C_DEC4) { x = 78mm; y = 12.35mm; rotation = 90; side = front; }
    constraint fixed_placement(C_NRF_VDD2) { x = 82mm; y = 13.2mm; rotation = 0; side = front; }
    constraint fixed_placement(C_NRF_VDD3) { x = 75.8mm; y = 13.4mm; rotation = 0; side = front; }
    constraint fixed_placement(Y_NRF) { x = 86.4mm; y = 13.07mm; rotation = 90; side = front; }
    constraint fixed_placement(C_XC1) { x = 89.06mm; y = 13.69mm; rotation = 90; side = front; }
    constraint fixed_placement(C_XC2) { x = 85.55mm; y = 10mm; rotation = 0; side = front; }
    constraint max_distance(C_ACCEL, U_ACCEL.VDD) { distance = 3mm; }
    // Quiet support/control parts near their actual consumers. These are
    // authored routing improvements, not manufacturer numerical maxima.
    constraint max_distance(R_RESET_NRF.2, U_NRF.P0_21_NRESET) { distance = 4mm; }
    constraint fixed_placement(R_RESET_NRF) { x = 84mm; y = 22.9mm; rotation = 0; side = front; }
    constraint fixed_placement(PWR/U_CHARGE) { x = 68mm; y = 35mm; rotation = 180; side = front; }
    constraint fixed_placement(PWR/C_SYS) { x = 64mm; y = 35mm; rotation = 90; side = front; }
    constraint fixed_placement(PWR/C_BAT) { x = 72mm; y = 35mm; rotation = 90; side = front; }
    constraint fixed_placement(PWR/C_USB) { x = 68mm; y = 39mm; rotation = 0; side = front; }
    constraint fixed_placement(PWR/R_ILIM) { x = 64.6mm; y = 38mm; rotation = 180; side = front; }
    constraint fixed_placement(PWR/R_ISET) { x = 71.2mm; y = 38.55mm; rotation = 270; side = front; }
    constraint max_distance(PWR/R_ILIM.1, PWR/U_CHARGE.ILIM) { distance = 3mm; }
    constraint max_distance(PWR/R_ISET.1, PWR/U_CHARGE.ISET) { distance = 3mm; }
    constraint fixed_placement(U_CC) { x = 34mm; y = 59mm; rotation = 0; side = front; }
    constraint fixed_placement(C_CC) { x = 33.4mm; y = 56.175mm; rotation = 180; side = front; }
    constraint fixed_placement(R_CC_OUT1) { x = 37.2mm; y = 59.9mm; rotation = 0; side = front; }
    constraint fixed_placement(R_CC_OUT2) { x = 37.2mm; y = 58.4mm; rotation = 0; side = front; }
    constraint max_distance(R_CC_OUT1.2, U_CC.OUT1) { distance = 4mm; }
    constraint max_distance(R_CC_OUT2.2, U_CC.OUT2) { distance = 4mm; }
    // Leave room below the modem for both pin-associated bypasses. Their
    // poses/routes are selected by CopperScript's generic decoupling intent.
    // Moved 2.1 mm right with the modem so the UART lines keep their order.
    constraint fixed_placement(U_MODEM_LEVEL) { x = 22.6mm; y = 42mm; rotation = 180; side = front; }
    constraint fixed_placement(U_MODEM_KEY) { x = 12mm; y = 40mm; rotation = 0; side = front; }
    constraint fixed_placement(R_KEY_PD) { x = 9mm; y = 40.3mm; rotation = 90; side = front; }
    // 2.7 mm below its earlier y = 30 mm so C_STATUS_A fits north of it, clear
    // of the cellular SMA; south of the chip its V3V3 trace cut V1V8_MODEM off
    // from C_STATUS_B.
    constraint fixed_placement(U_MODEM_STATUS) { x = 4.5mm; y = 32.7mm; rotation = 0; side = front; }
    // 3.5 mm: with the module turned, VCC faces J_BAT and 3 mm has no legal pose.
    constraint max_distance(C_GNSS, U_GNSS.VCC) { distance = 3.5mm; }
    // Front-side translator decouplers stay at their supply pins; with no
    // back-side placement the planner would otherwise park them anywhere.
    constraint max_distance(C_LEVEL_A.1, U_MODEM_LEVEL.VCCA) { distance = 3mm; }
    constraint max_distance(C_LEVEL_B.1, U_MODEM_LEVEL.VCCB) { distance = 3mm; }
    constraint max_distance(C_STATUS_A.1, U_MODEM_STATUS.VCCA) { distance = 3mm; }
    constraint max_distance(C_STATUS_B.1, U_MODEM_STATUS.VCCB) { distance = 3mm; }
    constraint max_distance(C_MODEM_BULK, U_MODEM.VBAT_1) { distance = 5mm; }
    // Between the cellular matching network and the modem's VBAT pads (55-57).
    constraint fixed_placement(C_MODEM_BULK) { x = 7mm; y = 20.6mm; rotation = 90; side = front; }
    // Modem GND pad 29 sits between USB_DM_MODEM and SIM_VCC with no room for
    // an off-pad via; allow a filled/capped GND via in the land instead.
    constraint via_in_pad(U_MODEM.GND_29) { process = "filled-capped"; }

    // The provisional 100 x 80 mm outline, previously the CLI fallback size.
    mechanical {
        outline rectangle { width = 100mm; height = 80mm; }
        edge LEFT { start = (0mm, 0mm); end = (0mm, 80mm); }
        edge RIGHT { start = (100mm, 0mm); end = (100mm, 80mm); }
        // JLCPCB JLC06161H-3313 (NP-155F) construction, the selected
        // fabrication stack (docs/stackup-selection.md). The antenna solver
        // reads it; the loss tangent is unpublished, so it is left out and the
        // simulated radiation efficiencies exclude dielectric loss.
        stackup {
            copper F.Cu { thickness = 0.035mm; }
            dielectric PP1 { thickness = 0.0994mm; er = 4.1; material = "3313"; type = prepreg; }
            copper In1.Cu { thickness = 0.0152mm; }
            dielectric Core1 { thickness = 0.55mm; er = 4.6; material = "NP-155F"; type = core; }
            copper In2.Cu { thickness = 0.0152mm; }
            dielectric PP2 { thickness = 0.1088mm; er = 4.16; material = "2116"; type = prepreg; }
            copper In3.Cu { thickness = 0.0152mm; }
            dielectric Core2 { thickness = 0.55mm; er = 4.6; material = "NP-155F"; type = core; }
            copper In4.Cu { thickness = 0.0152mm; }
            dielectric PP3 { thickness = 0.0994mm; er = 4.1; material = "3313"; type = prepreg; }
            copper B.Cu { thickness = 0.035mm; }
        }
        // Via-free USB corridor between FL_USB's MCU-side (OUT) pads and
        // U_MCU PA11/PA12. Ordinary escapes are reserved before critical
        // routing; without this the PA13/SWDIO escape via lands at
        // (41.4, 23.25) and forces the USB pair around the choke and MCU.
        // Tracks (the USB pair) and the top GND pour may still use it.
        copper_keepout USB_MCU_CORRIDOR polygon {
            vertices = [(40.1mm, 21.6mm), (42.0mm, 21.6mm), (42.0mm, 24.0mm), (40.1mm, 24.0mm)];
            layers = "F.Cu,In1.Cu,In2.Cu,In3.Cu,In4.Cu,B.Cu";
            block_tracks = false;
            block_vias = true;
            block_pads = false;
            block_zones = false;
            block_footprints = false;
        }
    }

    // Board identity in the open area between the GNSS module and J_BAT.
    silkscreen {
        text BOARD_ID {
            text = "CopperAssetTracker\nRev A";
            position = (79mm, 57mm);
            size = 1.2mm;
            thickness = 0.18mm;
        }
        // Stacked labels are a tenth of the logo: 8 mm keeps them at the
        // 0.8 mm minimum silkscreen text height.
        branding {
            position = (80mm, 66mm);
            size = 8mm;
            layout = stacked;
        }
    }

    // Explicit critical profiles; never inferred from net names. The choke
    // divides USB into two pairs. Width/gap/layer choices below are provisional
    // geometric intent, NOT impedance qualification (see full-vertical docs).
    // No invented length/skew limits or fabricated field-solver evidence.
    // USB may transition as a matched via pair to In2.Cu, next to the
    // In1.Cu return plane. Two vias/member allow escape and return to F.Cu.
    // These provisional common width/gap values still need layer-specific
    // stackup qualification. Both allowed signal layers share In1.Cu; require
    // stitching when that reference changes, not a one-plane-only dummy via.
    // This declared topology still does not certify actual filled continuity.
    constraint routing(USB_DP_MCU) {
        kind = differential; priority = 100; partner = USB_DM_MCU;
        width = 0.18mm; pair_gap = 0.2mm; target_impedance_ohms = 90;
        allowed_layers = "F.Cu,In2.Cu"; max_vias = 2;
        require_return_vias = true; return_via_net = "GND";
        return_via_policy = "reference_change"; shared_reference_layer = "In1.Cu";
        maximum_return_via_distance = 2mm;
    }
    constraint routing(USB_DM_MCU) {
        kind = differential; priority = 100; partner = USB_DP_MCU;
        width = 0.18mm; pair_gap = 0.2mm; target_impedance_ohms = 90;
        allowed_layers = "F.Cu,In2.Cu"; max_vias = 2;
        require_return_vias = true; return_via_net = "GND";
        return_via_policy = "reference_change"; shared_reference_layer = "In1.Cu";
        maximum_return_via_distance = 2mm;
    }
    constraint routing(USB_DP_MODEM) {
        kind = differential; priority = 100; partner = USB_DM_MODEM;
        width = 0.18mm; pair_gap = 0.2mm; target_impedance_ohms = 90;
        allowed_layers = "F.Cu,In2.Cu"; max_vias = 2;
        require_return_vias = true; return_via_net = "GND";
        return_via_policy = "reference_change"; shared_reference_layer = "In1.Cu";
        maximum_return_via_distance = 2mm;
    }
    constraint routing(USB_DM_MODEM) {
        kind = differential; priority = 100; partner = USB_DP_MODEM;
        width = 0.18mm; pair_gap = 0.2mm; target_impedance_ohms = 90;
        allowed_layers = "F.Cu,In2.Cu"; max_vias = 2;
        require_return_vias = true; return_via_net = "GND";
        return_via_policy = "reference_change"; shared_reference_layer = "In1.Cu";
        maximum_return_via_distance = 2mm;
    }
    // Nominal 50-ohm grounded coplanar feeds over In1.Cu GND: 0.142 mm width
    // and 0.201 mm gap from the JLCPCB calculator for JLC06161H-3313
    // (revisions/rf-layout-v1/cellular-impedance-calculator.json). Not measured.
    // The cellular feed is three nets split by the matching network, within
    // the 20 mm module-to-antenna maximum: 8 + 4 mm routed budgets, and the
    // antenna-side segment fixed by its two pads (C_CELL_SERIES and the LTE
    // feed, 7.1 mm apart). That net also carries the radiator's copper, which
    // a max_length would count, so it has none.
    constraint routing(CELL_RF) {
        kind = critical; topology = tree; priority = 120; target_impedance_ohms = 50;
        width = 0.142mm; clearance = 0.201mm;
        allowed_layers = "F.Cu"; max_vias = 0; max_length = 8mm;
    }
    constraint routing(CELL_RF_MATCH) {
        kind = critical; topology = tree; priority = 120; target_impedance_ohms = 50;
        width = 0.142mm; clearance = 0.201mm;
        allowed_layers = "F.Cu"; max_vias = 0; max_length = 4mm;
    }
    constraint routing(CELL_RF_ANT) {
        kind = rf_feed; priority = 120; target_impedance_ohms = 50;
        width = 0.142mm; clearance = 0.201mm;
        allowed_layers = "F.Cu"; max_vias = 0;
    }
    // The GNSS feed is split by its matching parts: RF_IN to the series part,
    // then a tree through the antenna-side shunt to the antenna feed.
    constraint routing(GNSS_RF) {
        kind = rf_feed; priority = 120; target_impedance_ohms = 50;
        width = 0.142mm; clearance = 0.201mm;
        allowed_layers = "F.Cu"; max_vias = 0;
    }
    constraint routing(GNSS_RF_ANT) {
        kind = critical; topology = tree; priority = 120; target_impedance_ohms = 50;
        width = 0.142mm; clearance = 0.201mm;
        allowed_layers = "F.Cu"; max_vias = 0;
    }
    // Nordic's chip-side matching geometry is not a generic 50-ohm feed.
    // Its three-terminal chip-side net includes the shunt capacitor. L1's
    // output runs to the trace antenna's pi lands, and the last segment is the
    // point-to-point antenna feed. Neither these profiles nor the provisional
    // placement qualify the matching layout.
    constraint routing(NRF_RF_RAW) {
        kind = critical; topology = tree;
        priority = 130; allowed_layers = "F.Cu"; max_vias = 0;
    }
    constraint routing(NRF_RF_ANT) {
        kind = critical; topology = tree; priority = 130;
        target_impedance_ohms = 50; allowed_layers = "F.Cu"; max_vias = 0;
    }
    constraint routing(ANT_FEED) {
        kind = rf_feed; priority = 130;
        target_impedance_ohms = 50; allowed_layers = "F.Cu"; max_vias = 0;
    }

    // Each oscillator net includes its load capacitor: critical tree, not
    // the point-to-point clock profile. No impedance claim or via fallback.
    constraint routing(NRF_XC1) {
        kind = critical; topology = tree; priority = 150;
        width = 0.18mm; allowed_layers = "F.Cu"; max_vias = 0; max_length = 8mm;
    }
    constraint routing(NRF_XC2) {
        // Reserve the narrower upper-pin path before the lower crystal net.
        kind = critical; topology = tree; priority = 151;
        width = 0.18mm; allowed_layers = "F.Cu"; max_vias = 0; max_length = 8mm;
    }
    constraint routing(NRF_DEC3) {
        kind = critical; priority = 155;
        width = 0.18mm; allowed_layers = "F.Cu"; max_vias = 0; max_length = 2mm;
    }
    // Initial distribution geometry, NOT a certified current rating. Local
    // switching loops, sense and paired power contacts belong to the macros.
    constraint routing(V3V8) { width = 0.8mm; breakout_width = 0.24mm; breakout_length = 1mm; }
    constraint routing(PWR/VSYS) { width = 0.8mm; breakout_width = 0.24mm; breakout_length = 1mm; }
    constraint routing(PWR/BAT) { width = 0.8mm; breakout_width = 0.24mm; breakout_length = 1mm; }

    // Inner GND references and 3.3 V distribution. In2.Cu remains the
    // adjacent signal layer for USB; In3.Cu supplies V3V3. The top GND pour
    // overlaps both converters' compatible owned GND zones. RF keepouts exclude fill
    // around chip matching, the feed and antenna corner.
    // Both zones require native refill and connected-copper signoff.
    constraint copper_zone(GND) {
        id = "ground-return-plane";
        layers = "In1.Cu,In4.Cu";
        inset = 0.5mm;
        pad_connection = solid;
    }
    constraint copper_zone(V3V3) {
        id = "logic-power-plane";
        layers = "In3.Cu";
        inset = 0.5mm;
        pad_connection = solid;
        island_policy = "remove_all";
    }
    constraint copper_zone(GND) {
        id = "top-ground-return"; layers = "F.Cu";
        polygon_mm = "0.5,0.5;99.5,0.5;99.5,79.5;0.5,79.5";
        priority = 1; pad_connection = solid; island_policy = "remove_all";
        allow_same_net_hard_macro_overlap = true;
    }

    // Source-selected realizations; asset versions and hashes come from dependencies.
    physical_macro nordic-rf: rf.NRF52832_NORDIC_MATCH_SIX_LAYER {
        member C3 = C_BT_MATCH;
        member L1 = L_BT_MATCH;
        member U1 = U_NRF;
        net feed = NRF_RF_ANT;
        net ground = GND;
        net raw = NRF_RF_RAW;
    }

    // Synthesized printed antennas (see the CopperScript language reference,
    // "Trace antenna synthesis"). Each region sits on the board edge with its
    // inner edge facing the ground planes; lowering generates a locked radiator,
    // an all-layer protected region and the feed pad's pose. `geometry` and
    // `tuned_for` come from `copper synthesize-antenna` (full-wave FDTD of this
    // outline, stack-up and GND zones): simulation evidence only, never bench,
    // enclosure or regulatory qualification.
    //
    // LTE B20 (791-862 MHz, the EU/Nordic coverage band) along the top edge,
    // fed from the modem's pi network at the left end. VSWR 3:1 is the target.
    // Synthesized (fine mesh, model revision 5): resonance 0.826 GHz, -3.2 dB
    // bare; the reported L-section (series 4.30 nH then shunt 6.16 pF from the
    // antenna side) MISSES at -5.3 dB, so the Figure 30 pi carries the match
    // (above); 59 % radiation efficiency without dielectric loss.
    // revisions/pcb-antennas-v1/lte-synthesis.json.
    // A 10 mm edge clearance reached only about -3 dB matched across B20 and
    // B8 together (one resonance over 19 %); B8, B28 and the high bands are
    // not covered by this radiator.
    constraint antenna(ANT_CELL.FEED) {
        name = "lte";
        x = 3.4mm; y = 0mm; width = 72.6mm; height = 10mm;
        ground = GND;
        bands = "791 MHz-862 MHz";
        max_return_loss_db = -6;
        track_width = 1.5mm;
        keepout_margin = 0.5mm;
        geometry = "monopole height=9.16mm length=68.2mm";
        tuned_for = "sha256:44da69392ba7fcc6a9a5517fd8116452a890f67b3ba362e2a2d31874d35cfab9";
    }
    // Bluetooth LE on the right edge beside the nRF52832. Synthesized (fine
    // mesh, model revision 5): resonance 2.315 GHz, -9.4 dB bare and -18.2 dB
    // worst over the band with series 2.03 pF then shunt 4.39 nH from the
    // antenna side (C_BT_SERIES, L_BT_SHUNT); 99 % radiation efficiency
    // without dielectric loss. revisions/pcb-antennas-v1/ble-synthesis.json.
    constraint antenna(ANT_BT.FEED) {
        name = "ble";
        x = 94mm; y = 16mm; width = 6mm; height = 24mm;
        ground = GND;
        bands = "2400 MHz-2483.5 MHz";
        track_width = 1mm;
        keepout_margin = 0.5mm;
        geometry = "monopole height=5.41mm length=24mm";
        tuned_for = "sha256:10c846dffb8fbfb8aa29eaecc98b70c683fb90aaf864e4259c15049f5889c6b1";
    }
    // GNSS L1/E1/B1/G1 (MAX-M10S) on the right edge below the BLE antenna.
    // Linear polarization: about 3 dB below a circularly polarized patch.
    // Synthesized (fine mesh, model revision 5): resonance 1.471 GHz, -5.6 dB
    // bare and -12.7 dB worst over the band with shunt 1.18 pF then series
    // 4.04 pF from the antenna side (C_GNSS_SHUNT, C_GNSS_SERIES); 98 %
    // radiation efficiency without dielectric loss. A 7 mm deep region reached
    // only -9.5 dB, and an inverted-F's short left its arm too short for L1.
    // revisions/pcb-antennas-v1/gnss-synthesis.json.
    constraint antenna(ANT_GNSS.FEED) {
        name = "gnss";
        x = 90mm; y = 44mm; width = 10mm; height = 36mm;
        ground = GND;
        bands = "1559 MHz-1606 MHz";
        track_width = 1mm;
        keepout_margin = 0.5mm;
        geometry = "monopole height=8.31mm length=40.46mm";
        tuned_for = "sha256:04f1b468ffb55400ff51d3479a4dc288dba9e2c2653160983855c7bf2d78260d";
    }

    physical_macro logic-buck-boost: logic_layout.TPS63020_SIX_LAYER_ALWAYS_ON on PWR {
        member U = U_LOGIC;
        member L = L_LOGIC;
        member C_IN = C_LOGIC_IN;
        member C_VINA = C_LOGIC_VINA;
        member C_OUT1 = C_LOGIC_OUT1;
        member C_OUT2 = C_LOGIC_OUT2;
        member C_OUT3 = C_LOGIC_OUT3;
        member R_TOP = R_LOGIC_FB_TOP;
        member R_BOT = R_LOGIC_FB_BOT;
        net VIN = VSYS;
        net VOUT = port.V3V3;
        net GND = port.GND;
        net FB = LOGIC_FB;
        net L1 = LOGIC_L1;
        net L2 = LOGIC_L2;
    }

    physical_macro modem-buck-boost: modem_layout.TPS63020_SIX_LAYER_ENABLED_SERIES_FEEDBACK on PWR {
        member U = U_MODEM;
        member L = L_MODEM;
        member C_IN = C_MODEM_IN;
        member C_VINA = C_MODEM_VINA;
        member C_OUT1 = C_MODEM_OUT1;
        member C_OUT2 = C_MODEM_OUT2;
        member C_OUT3 = C_MODEM_OUT3;
        member R_TOP = R_MODEM_FB_TOP;
        member R_TOP2 = R_MODEM_FB_TOP2;
        member R_BOT = R_MODEM_FB_BOT;
        member R_EN_PD = R_MODEM_EN_PD;
        net VIN = VSYS;
        net VOUT = port.V3V8;
        net GND = port.GND;
        net FB = MODEM_FB;
        net FB_SERIES = MODEM_FB_SERIES;
        net L1 = MODEM_L1;
        net L2 = MODEM_L2;
        net EN = port.MODEM_EN;
    }
}
